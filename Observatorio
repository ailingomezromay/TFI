  ["Chubut",1,7],["Santa Cruz",1,8],["Tierra del Fuego",1,9]
];

/* ============================================================
   2) PUNTAJE DE RIESGO (z-scores del último año, terciles)
   ============================================================ */
const prom = a => a.reduce((x,y)=>x+y,0)/a.length;
const desvio = a => { const m = prom(a); return Math.sqrt(prom(a.map(v=>(v-m)**2))); };
function z(vals){ const m = prom(vals), s = desvio(vals); return vals.map(v=>(v-m)/s); }

const nombres = POSICIONES.map(p=>p[0]);
const ult = k => nombres.map(n => RAW.data[n][k][8]);
const zA = z(ult("abandono")), zB = z(ult("bajo_peso")), zT = z(ult("tmi"));
const scores = nombres.map((n,i)=> zA[i] + zB[i] + zT[i]);
const orden = [...scores].sort((a,b)=>a-b);
const t1 = orden[Math.floor(orden.length/3)], t2 = orden[Math.floor(orden.length*2/3)];

const datos = POSICIONES.map(([nombre,col,fila],i)=>{
  const d = RAW.data[nombre];
  const riesgo = scores[i] > t2 ? "alto" : scores[i] > t1 ? "medio" : "bajo";
  return {nombre,col,fila,riesgo,...d};
});

/* ============================================================
   3) KPIs GENERALES
   ============================================================ */
document.getElementById("kpiAlto").textContent = datos.filter(d=>d.riesgo==="alto").length;
document.getElementById("kpiAband").textContent = prom(ult("abandono")).toFixed(1)+"%";
document.getElementById("kpiBajo").textContent  = prom(ult("bajo_peso")).toFixed(1)+"%";

/* ============================================================
   4) MAPA DE MOSAICOS
   ============================================================ */
const COLORES = {alto:"#C0532F", medio:"#E8A33D", bajo:"#3E7C59"};
const mapa = document.getElementById("mapa");
const NFILAS = 10, NCOLS = 6;
const celdas = {};
datos.forEach(d=> celdas[d.fila*NCOLS+d.col] = d);

for(let f=0; f<NFILAS; f++){
  for(let c=0; c<NCOLS; c++){
    const d = celdas[f*NCOLS+c];
    if(d){
      const b = document.createElement("button");
      b.className = "tile";
      b.style.background = COLORES[d.riesgo];
      b.textContent = d.nombre === "Santiago del Estero" ? "Sgo. Estero"
                    : d.nombre === "Tierra del Fuego" ? "T. del Fuego" : d.nombre;
      b.setAttribute("aria-label", d.nombre + " — riesgo " + d.riesgo);
      b.addEventListener("click", ()=> seleccionar(d, b));
      mapa.appendChild(b);
      d._el = b;
    } else {
      const v = document.createElement("div");
      v.className = "tile vacio";
      mapa.appendChild(v);
    }
  }
}

/* ============================================================
   5) PANEL DE DETALLE + TENDENCIA
   ============================================================ */
let chartTrend = null;
const fmt = (v,suf) => v==null ? "s/d" : v+suf;
function seleccionar(d, el){
  document.querySelectorAll(".tile.sel").forEach(t=>t.classList.remove("sel"));
  if(el) el.classList.add("sel");
  document.getElementById("dNombre").textContent = d.nombre;
  const badge = document.getElementById("dRiesgo");
  badge.textContent = "Riesgo " + d.riesgo;
  badge.style.background = COLORES[d.riesgo];
  document.getElementById("dAband").textContent = fmt(d.abandono[8],"%");
  document.getElementById("dBajo").textContent  = fmt(d.bajo_peso[8],"%");
  document.getElementById("dTmi").textContent   = fmt(d.tmi[8],"");

  if(chartTrend) chartTrend.destroy();
  chartTrend = new Chart(document.getElementById("chartTrend"), {
    type:"line",
    data:{ labels:YEARS, datasets:[
      {label:"Abandono secundaria (%)", data:d.abandono, borderColor:"#C0532F", backgroundColor:"#C0532F", tension:.3, spanGaps:true},
      {label:"Bajo peso al nacer (%)", data:d.bajo_peso, borderColor:"#3E7C59", backgroundColor:"#3E7C59", tension:.3, spanGaps:true},
      {label:"Mortalidad infantil (‰)", data:d.tmi, borderColor:"#E8A33D", backgroundColor:"#E8A33D", tension:.3, spanGaps:true, borderDash:[5,4]}
    ]},
    options:{ responsive:true, plugins:{legend:{labels:{font:{size:10.5}}}} }
  });
}

/* ============================================================
   6) DISPERSIÓN + CORRELACIÓN SEGÚN REZAGO
   Pares (bajo peso año t−L, abandono año t), todas las provincias.
   ============================================================ */
function pearson(xs, ys){
  const n = xs.length, mx = prom(xs), my = prom(ys);
  let num=0, dx=0, dy=0;
  for(let i=0;i<n;i++){ num+=(xs[i]-mx)*(ys[i]-my); dx+=(xs[i]-mx)**2; dy+=(ys[i]-my)**2; }
  return num/Math.sqrt(dx*dy);
}

let chartScatter = null;
function dibujarScatter(lag){
  const pts = [], xs = [], ys = [];
  datos.forEach(d=>{
    for(let t=lag; t<YEARS.length; t++){
      const x = d.bajo_peso[t-lag], y = d.abandono[t];
      if(x!=null && y!=null){ pts.push({x,y}); xs.push(x); ys.push(y); }
    }
  });
  const r = pearson(xs, ys);
  document.getElementById("rVal").textContent = "r = " + r.toFixed(3) + "  (n=" + xs.length + ")";

  if(chartScatter) chartScatter.destroy();
  chartScatter = new Chart(document.getElementById("chartScatter"), {
    type:"scatter",
    data:{datasets:[{ label:"Provincia-año", data:pts, backgroundColor:"rgba(62,124,89,.55)" }]},
    options:{
      responsive:true, maintainAspectRatio:false,
      plugins:{legend:{display:false}},
      scales:{
        x:{title:{display:true,text:"Bajo peso al nacer (%) — año t−"+lag}},
        y:{title:{display:true,text:"Abandono secundaria (%) — año t"}}
      }
    }
  });
}

document.querySelectorAll(".lagbtn").forEach(b=>{
  b.addEventListener("click", ()=>{
    document.querySelectorAll(".lagbtn").forEach(x=>x.classList.remove("on"));
    b.classList.add("on");
    dibujarScatter(+b.dataset.lag);
  });
});

