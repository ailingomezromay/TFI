const YEARS = RAW.years;

// [nombre, columna, fila] — disposición esquemática del mapa
const POSICIONES = [
  ["Jujuy",1,0],["Salta",1,1],["Formosa",2,1],
  ["Tucumán",1,2],["Santiago del Estero",2,2],["Chaco",3,2],["Corrientes",4,2],["Misiones",5,2],
